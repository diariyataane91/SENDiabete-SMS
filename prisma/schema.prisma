generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  ADMIN
}

enum MeasureType {
  GLYCEMIE
  TENSION
}

enum DelegationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(DOCTOR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctorProfile DoctorProfile?
}

model DoctorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastNameEnc      String
  firstNameEnc     String
  ordreNumberHash  String   @unique
  status           String   @default("PENDING")
  
  smsQuotaMonthly  Int      @default(20)
  smsUsedThisMonth Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  patients           Patient[]
  delegationsGiven   Delegation[] @relation("delegator")
  delegationsReceived Delegation[] @relation("delegatee")
  ordonnances        Ordonnance[]
}

model Patient {
  id               String   @id @default(cuid())
  lastNameEnc      String
  firstNameEnc     String
  phoneE164        String   @unique
  referentDoctorId String
  referentDoctor   DoctorProfile @relation(fields: [referentDoctorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  mesures          Mesure[]
  objectifs        Objectif[]
  ordonnances      Ordonnance[]
  delegations      Delegation[]
}

model Objectif {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  glycemieMax    Int?
  systoliqueMax  Int?
  diastoliqueMax Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Mesure {
  id             String      @id @default(cuid())
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           MeasureType
  valeurGlycemie Int?
  systolique     Int?
  diastolique    Int?
  measuredAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())
  alertRaised    Boolean     @default(false)
  alertReason    String?
}

model Ordonnance {
  id         String   @id @default(cuid())
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId   String
  doctor     DoctorProfile @relation(fields: [doctorId], references: [id])
  contentEnc String
  issuedAt   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Delegation {
  id          String        @id @default(cuid())
  delegatorId String
  delegator   DoctorProfile @relation("delegator", fields: [delegatorId], references: [id])
  delegateeId String
  delegatee   DoctorProfile @relation("delegatee", fields: [delegateeId], references: [id])
  patientId   String?
  patient     Patient?      @relation(fields: [patientId], references: [id])
  startsAt    DateTime
  endsAt      DateTime
  revokedAt   DateTime?
  status      DelegationStatus @default(PENDING)
  createdAt   DateTime      @default(now())
}

enum AuditAction {
  LOGIN
  PATIENT_READ
  PATIENT_CREATE
  MEASURE_CREATE
  ORDONNANCE_CREATE
  DELEGATION_CREATE
  DELEGATION_ACCEPT
  SMS_SEND
  DOCTOR_VERIFIED
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String      // L'ID du User qui fait l'action
  action     AuditAction
  targetType String?     // Ex: "Patient", "Mesure"
  targetId   String?     // L'ID de l'objet concerné
  metadata   String?     // Détails (ex: le nom du patient concerné)
  ipAddress  String?
  createdAt  DateTime    @default(now())
}