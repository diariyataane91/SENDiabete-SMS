generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  ADMIN
}

enum MeasureType {
  GLYCEMIE
  TENSION
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(DOCTOR)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  doctorProfile DoctorProfile?
}

model DoctorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastNameEnc      String
  firstNameEnc     String
  ordreNumberHash  String   @unique
  status           String   @default("PENDING")
  
  smsQuotaMonthly  Int      @default(20)
  smsUsedThisMonth Int      @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  patients         Patient[]
}

model Patient {
  id               String   @id @default(cuid())
  lastNameEnc      String
  firstNameEnc     String
  phoneE164        String   @unique
  referentDoctorId String
  referentDoctor   DoctorProfile @relation(fields: [referentDoctorId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  mesures          Mesure[]
  objectifs        Objectif[]
}

model Objectif {
  id             String   @id @default(cuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  glycemieMax    Int?
  systoliqueMax  Int?
  diastoliqueMax Int?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Mesure {
  id             String      @id @default(cuid())
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           MeasureType
  valeurGlycemie Int?
  systolique     Int?
  diastolique    Int?
  measuredAt     DateTime    @default(now())
  createdAt      DateTime    @default(now())
  alertRaised    Boolean     @default(false)
  alertReason    String?
}